{
    "name": "asmi046/laravel-mobile-menu",
    "description": "Reusable slide-in mobile menu Blade component for Laravel projects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade",
        "mobile-menu",
        "responsive",
        "ui"
    ],
    "authors": [
        {
            "name": "asmi046",
            "email": "asmi046@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Asmi046\\MobileMenu\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asmi046\\MobileMenu\\MobileMenuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
